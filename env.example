# ==========================================
# .env.example — Copia este archivo como .env
# y rellena con tus valores reales.
# NUNCA subas el .env real a Git.
# ==========================================

# --- Telegram (obligatorio) ---
TELEGRAM_TOKEN=tu_token_del_bot_aqui
TELEGRAM_CHAT_ID=-123456789

# --- Comportamiento del bot (opcional, tienen valores por defecto) ---
INTERVALO_MINUTOS=5
UMBRAL_BAJADA_PORCENTAJE=3
TIMEOUT_REQUEST=20

# --- Base de datos (opcional) ---
DB_PATH=ofertas.db
